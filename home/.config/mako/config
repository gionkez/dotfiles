max-history=50
sort=-time

on-button-left=invoke-default-action
on-button-middle=none
on-button-right=dismiss
on-touch=dismiss
on-notify=none

font=Iosevka NFM Medium 12
width=300
height=150
margin=15
padding=3
border-color=#00918B
border-size=3
border-radius=5
icons=0
markup=1
actions=1
format=<b>%s</b>\n%b
text-alignment=left
max-visible=3
layer=overlay
anchor=top-right

[urgency=low]
background-color=#FFFCFF
text-color=#191719
default-timeout=3000

[urgency=normal]
background-color=#7FD1AE
text-color=#191719
default-timeout=5000

[urgency=critical]
background-color=#CF68D9
text-color=#FFFCFF
default-timeout=0
